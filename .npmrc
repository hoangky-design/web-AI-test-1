# better-sqlite3 and bcrypt ship prebuilt binaries (linux/macOS/windows, x64/arm64) and load them at
# runtime, so no install scripts / compilers are needed. Without this, `npm ci` tries to compile
# better-sqlite3 with node-gyp (needs make + g++). Remove this line only on an unusual platform
# that has no prebuilt binary (then install build-essential first).
ignore-scripts=true
